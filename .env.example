# Frostora — environment variables (template only, no real values)
# Copy to .env locally / set in Vercel → Settings → Environment Variables.
# NEVER commit a filled-in .env to git.

# Database — local file for dev, Turso (libsql) for production.
# Local:  DATABASE_URL=<redacted>
# Turso:  DATABASE_URL=<redacted>
DATABASE_URL=<redacted>

# Turso auth token — required only with a libsql:// DATABASE_URL.
DATABASE_AUTH_TOKEN=

# Feedback — Web3Forms access key for the About-page Feedback pill.
# When unset, submitFeedback returns { ok: false } and sends nothing.
# It must NEVER appear in source code or in git.
WEB3FORMS_ACCESS_KEY=

# InnerTube — YouTube Music API key used for search / player / browse.
# This is the shared public InnerTube key used by Echo Music, yt-dlp and
# other YouTube Music clients; it is NOT tied to any Google account or billing.
# It must still NEVER be hardcoded in source code — set it here / in Vercel.
# When unset, YouTube Music search and playback will fail.
INNERTUBE_KEY=

# Blob storage for avatar + wallpaper uploads.
# Vercel Blob when set; otherwise uploads go to a local uploads/ dir (dev only).
BLOB_READ_WRITE_TOKEN=

# Public URL of the deployed app (used by the Android wrapper + CI).
# Example: https://frostora.vercel.app
FROSTORA_URL=

# Dev server port (default 3000).
PORT=3000
